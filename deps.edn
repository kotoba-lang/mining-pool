;; mining-pool — Stratum v1 protocol logic, share validation, vardiff, and a
;; PPLNS payout reference implementation. Protocol/logic layer only in this
;; v1 — no hardened production TCP server (see the ADR's out-of-scope list).
{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/btc-mining {:git/sha "3f8f4190cd70cd727c3f06d41f4d3c41f3034ab1"}
        io.github.kotoba-lang/btc-crypto {:git/sha "a9109c4507c6f1f2b0b90cdf202efa6b02150e27"}
        io.github.kotoba-lang/eth-crypto {:git/sha "eebb35b56c1ddb7987b053bdf0c789c77c22c10f"}
        io.github.kotoba-lang/crypto     {:git/sha "c4f825c166c0095f7b020c503c56a0a1fb10af07"}
        io.github.kotoba-lang/json       {:git/sha "deb01e68fc6ddd936953575ef54f06dc26f89640"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}
  :kotoba {:replace-paths ["src"]
           :replace-deps {io.github.kotoba-lang/amu
                          {:git/url "https://github.com/kotoba-lang/amu.git"
                           :git/sha "def5161be96d489539175813326a316da46268be"}}
           :main-opts ["-m" "kotoba.compiler.cli"]}}}
